# Sin variables: demo local. No introducir datos reales en la demo.
NEXT_PUBLIC_DATA_MODE=demo
# Para activar Supabase, aplicar la migración y cambiar el modo a supabase.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Recepcionista conversacional del enlace público (docs/recepcionista-ia.md).
# Vacío: apagada, el enlace usa el formulario guiado de siempre.
# simulated: asistente por reglas, SIN IA y sin coste (solo DEMO/TEST).
# anthropic: modelo de IA real, de pago; solo funciona si además hay clave, un
# límite diario de llamadas mayor que 0 y RECEPTIONIST_SPEND_LIMIT_SET=true.
# Sin ellos queda apagada.
RECEPTIONIST_PROVIDER=
# Clave de la API de Anthropic (solo servidor; nunca NEXT_PUBLIC_).
RECEPTIONIST_ANTHROPIC_API_KEY=
# Máximo de llamadas al modelo por día y por instancia del servidor.
RECEPTIONIST_DAILY_CALL_LIMIT=
# true solo cuando haya un límite de gasto configurado en la consola del
# proveedor: es el único techo común a todas las instancias del servidor.
RECEPTIONIST_SPEND_LIMIT_SET=
# Opcionales: modelo (por defecto claude-haiku-5-5), tokens de salida por
# respuesta (por defecto 400, máximo 1024) y tiempo de espera en ms.
RECEPTIONIST_MODEL=
RECEPTIONIST_MAX_OUTPUT_TOKENS=
RECEPTIONIST_TIMEOUT_MS=
# Aviso por correo al owner/staff cuando llega una solicitud pública nueva.
# Solo hace falta para ese aviso; el resto de la app funciona sin ellas.
# SUPABASE_SECRET_KEY: clave "secret" del proyecto (nunca "publishable"/anon),
# en Supabase → Project Settings → API Keys. Solo se usa en el servidor
# (nunca en el navegador) para consultar los emails del equipo del taller.
SUPABASE_SECRET_KEY=
# RESEND_API_KEY: clave de API de resend.com.
RESEND_API_KEY=
# Remitente del aviso. Vacío usa la dirección de pruebas de Resend
# (onboarding@resend.dev), que solo entrega al correo de tu propia cuenta
# de Resend -- válida para probar, pero no llega a otros owner/staff.
# Verifica un dominio propio en Resend antes de depender de esto en real.
NOTIFICATIONS_FROM_EMAIL=
# Identificación del taller en el aviso legal de la recepción pública
# (RGPD/LOPDGDD). Sin estos dos datos, esa página muestra un aviso de
# "no compartir este enlace todavía" en vez de identificar al responsable
# del tratamiento. Cada taller piloto es su propio despliegue de Vercel,
# así que esto se configura aquí y no en la base de datos.
LEGAL_TAX_ID=
LEGAL_CONTACT_EMAIL=
# Identificación de quien opera TALLERIA en los términos de servicio que
# acepta cada taller al darse de alta (/terminos). Sin estos tres datos,
# esa página muestra un aviso de "términos pendientes de completar".
# Dejar vacíos mientras TALLERIA no tenga una entidad o autónoma definida
# detrás: no rellenar con datos inventados ni de otra persona.
OPERATOR_NAME=
OPERATOR_TAX_ID=
OPERATOR_CONTACT_EMAIL=
# NEXT_PUBLIC_SENTRY_DSN: DSN de Sentry (no es secreto, por eso es público).
# Sin ella, Sentry no se inicializa y la app funciona igual. Solo se usa
# para monitorización de errores: sin Session Replay ni trazas de rendimiento.
NEXT_PUBLIC_SENTRY_DSN=
